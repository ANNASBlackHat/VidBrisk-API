# Video Generation Pipeline Configuration

# Gemini API Key (for LLM script cleaning & beat structuring)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Footage Engine Database & Vector Store (Postgres + Zilliz)
DATABASE_URL=postgresql://postgres:password@localhost:5432/footage_engine
ZILLIZ_URI=https://in03-xxxx.serverless.gcp-us-west1.zillizcloud.com
ZILLIZ_TOKEN=your_zilliz_token
ZILLIZ_COLLECTION_NAME=footage_chunks

# Storage settings
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
OUTPUT_DIR=./output

# TTS & Alignment
DEFAULT_TTS_PROVIDER=kokoro
DEFAULT_ALIGNER_PROVIDER=mock
KOKORO_VOICE=af_heart
